{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test tests --timeout 5000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "dev": "bun run --watch src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "start": "bun run dist/cli.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/swagger": "^1.3.1",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.2.1",
    "elysia": "latest",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "@biomejs/biome": "^1.9.4"
  },
  "module": "src/index.js"
}
