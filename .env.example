# 저장소 루트의 .env로 복사한 뒤 필수 값을 입력하세요. 실제 값은 커밋하지 않습니다.
# MySQL, backend, collector는 root와 동일한 DB_PASSWORD를 사용합니다.
DB_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
JUNGOL_USERNAME=
JUNGOL_PASSWORD=

# 선택: 프런트엔드 빌드에 사용하는 공개 Kakao JavaScript 앱 키
VITE_KAKAO_MAP_API_KEY=

# 선택: backend 또는 collector 장애를 전송할 Discord 긴급 알림 Webhook URL
# 비어 있으면 긴급 알림 기능만 비활성화됩니다.
WEBHOOK_URL=

# --- GitHub production Environment Secrets (여기에 실제 값을 적지 마세요) ---
# 필수 런타임: DB_PASSWORD, JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD,
# JUNGOL_USERNAME, JUNGOL_PASSWORD
# 선택: VITE_KAKAO_MAP_API_KEY, WEBHOOK_URL
# 필수 SSH 배포: DEPLOY_HOST, DEPLOY_USER, DEPLOY_PORT, DEPLOY_KEY
# 배포는 런타임/빌드 값으로 서버 루트 .env를 생성합니다.
# DB 주소·계정·이름, URL·포트·모드와 수집 설정은 코드/Compose에 고정합니다.
