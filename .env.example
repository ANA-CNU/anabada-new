# 저장소 루트에 .env로 복사하세요. 값이 채워진 파일은 커밋하지 않습니다.
# GitHub production Environment Secrets 필수값
DB_PASSWORD=
# 32자 이상. 예를 들어 openssl rand -hex 32로 생성할 수 있습니다.
JWT_SECRET=
# MinIO 전용 서비스 계정. 비밀번호는 최소 8자이며 임의의 긴 값 사용을 권장합니다.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 기존 Backstage 앱 자격 증명입니다. 풀이 수집과 OAuth 로그인에 사용합니다.
# Backstage에 https://bada.anacnu.com/auth/solved-ac/callback 을 등록하세요.
# 로컬 로그인도 테스트하려면 http://localhost:20050/auth/solved-ac/callback 도 등록하세요.
SOLVED_AC_CLIENT_ID=
SOLVED_AC_CLIENT_SECRET=

# 선택 GitHub production Environment Secrets: 공개 Kakao JavaScript 앱 키와 오류 알림 주소
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
WEBHOOK_URL=

# 운영 Secrets 목록: DB_PASSWORD JWT_SECRET MINIO_ACCESS_KEY MINIO_SECRET_KEY
# SOLVED_AC_CLIENT_ID SOLVED_AC_CLIENT_SECRET NEXT_PUBLIC_KAKAO_MAP_API_KEY WEBHOOK_URL
# Compose가 앱 주소, 내부 DB/MinIO 주소와 포트를 설정합니다. 운영 공개 포트는 Nginx의 80뿐입니다.
