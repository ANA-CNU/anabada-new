# 저장소 루트의 .env로 복사한 뒤 필수 값을 입력하세요. 실제 값은 커밋하지 않습니다.
# MySQL, backend는 root와 동일한 DB_PASSWORD를 사용합니다.
DB_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 선택: 프런트엔드 빌드에 사용하는 공개 Kakao JavaScript 앱 키
VITE_KAKAO_MAP_API_KEY=

# 선택 사항: backend 장애를 전송할 Discord 긴급 알림 Webhook URL
# 비어 있으면 긴급 알림 기능만 비활성화됩니다.
WEBHOOK_URL=

# 백준 이관·채점 현황 수집은 기존 DB_PASSWORD를 사용합니다.
# solved.ac 과거 풀이와 신규 정답 정산에 필요한 Backstage 앱 자격 증명입니다.
# 신규 회원의 백준 계정 연결은 브라우저의 공개 프로필로 확인합니다.
SOLVED_AC_CLIENT_ID=
SOLVED_AC_CLIENT_SECRET=

# --- GitHub production Environment Secrets (여기에 실제 값을 적지 마세요) ---
# 필수 런타임: DB_PASSWORD, JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD
# 백준 풀이 적재 및 정산: SOLVED_AC_CLIENT_ID, SOLVED_AC_CLIENT_SECRET
# 선택 사항: VITE_KAKAO_MAP_API_KEY, WEBHOOK_URL
# bada_deploy 러너가 VM에서 직접 배포하고 운영 checkout의 .env를 생성합니다.
# DB 주소·계정·이름, URL·포트·모드는 코드와 Compose에 고정합니다.
